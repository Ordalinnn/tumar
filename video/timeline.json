{
  "total": 106.911,
  "scenes": [
    {
      "id": "s1",
      "in": 0.4,
      "out": 11.614,
      "cues": [
        {
          "scene": "s1",
          "text": "Тумар — радар медленных схем.",
          "wav": "oc01.wav",
          "dur": 3.007,
          "at": 1.0
        },
        {
          "scene": "s1",
          "text": "Прототип, который замечает схему раньше, чем клиент потеряет деньги.",
          "wav": "oc02.wav",
          "dur": 5.857,
          "at": 4.457
        }
      ]
    },
    {
      "id": "s2",
      "in": 11.734,
      "out": 27.524,
      "cues": [
        {
          "scene": "s2",
          "text": "Один перевод новому получателю ничего не значит. Банк пропускает все три.",
          "wav": "oc03.wav",
          "dur": 6.345,
          "at": 12.334
        },
        {
          "scene": "s2",
          "text": "А пять за четыре месяца — уже схема. День сто шестнадцатый: заявка на депозит.",
          "wav": "oc04.wav",
          "dur": 7.095,
          "at": 19.129
        }
      ]
    },
    {
      "id": "s3",
      "in": 27.644,
      "out": 40.869,
      "cues": [
        {
          "scene": "s3",
          "text": "Радар считает четыре вещи: сколько ушло новым получателям за девяносто дней, растёт ли темп, сколько признаков сходится и согласился ли клиент на паузу.",
          "wav": "oc05.wav",
          "dur": 11.325,
          "at": 28.244
        }
      ]
    },
    {
      "id": "s4",
      "in": 40.989,
      "out": 55.891,
      "cues": [
        {
          "scene": "s4",
          "text": "Клиент видит предупреждение до операции.",
          "wav": "oc06.wav",
          "dur": 3.584,
          "at": 41.589
        },
        {
          "scene": "s4",
          "text": "Аналитик — всю историю и день, когда всё началось.",
          "wav": "oc07.wav",
          "dur": 4.502,
          "at": 45.623
        },
        {
          "scene": "s4",
          "text": "Качество — те же слепые тесты, без купюр.",
          "wav": "oc08.wav",
          "dur": 4.016,
          "at": 50.575
        }
      ]
    },
    {
      "id": "s5",
      "in": 56.011,
      "out": 76.771,
      "cues": [
        {
          "scene": "s5",
          "text": "Первый слепой тест — ноль из пяти. Радар не поймал ничего.",
          "wav": "oc09.wav",
          "dur": 5.449,
          "at": 56.611
        },
        {
          "scene": "s5",
          "text": "Второй — восемь из десяти, но тревожил девять честных клиентов из десяти.",
          "wav": "oc10.wav",
          "dur": 5.952,
          "at": 62.51
        },
        {
          "scene": "s5",
          "text": "Третий — десять из десяти и ни одной ложной тревоги. Пороги мы не подбирали.",
          "wav": "oc11.wav",
          "dur": 6.559,
          "at": 68.912
        }
      ]
    },
    {
      "id": "s6",
      "in": 76.891,
      "out": 88.845,
      "cues": [
        {
          "scene": "s6",
          "text": "Слабые места не прячем: пауза в защите сработала ноль раз из четырёх.",
          "wav": "oc12.wav",
          "dur": 5.629,
          "at": 77.491
        },
        {
          "scene": "s6",
          "text": "Это учебный прототип, а не банковский продукт.",
          "wav": "oc13.wav",
          "dur": 3.975,
          "at": 83.57
        }
      ]
    },
    {
      "id": "s7",
      "in": 88.965,
      "out": 99.519,
      "cues": [
        {
          "scene": "s7",
          "text": "Питон, Стримлит, сорок пять тестов. Без внешних API и интернета — модель не уходит из контура.",
          "wav": "oc14.wav",
          "dur": 8.654,
          "at": 89.565
        }
      ]
    },
    {
      "id": "s8",
      "in": 99.639,
      "out": 106.711,
      "cues": [
        {
          "scene": "s8",
          "text": "Тумар. Сайт, слайды и PDF — по ссылке.",
          "wav": "oc15.wav",
          "dur": 5.172,
          "at": 100.239
        }
      ]
    }
  ]
}